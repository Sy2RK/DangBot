{
  "name": "dangbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wechat group agent automation bot MVP.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "hermes:bootstrap": "node scripts/hermes/bootstrap-runtime.mjs",
    "hermes:bootstrap:browser": "node scripts/hermes/bootstrap-runtime.mjs --with-browser",
    "hermes:bootstrap:browser-download": "node scripts/hermes/bootstrap-runtime.mjs --with-browser --download-browser",
    "hermes:run": "node scripts/hermes/run-dedicated.mjs",
    "hermes:install:launchd": "node scripts/hermes/install-launchd.mjs",
    "hermes:preflight:offline": "tsx scripts/hermes/offline-preflight.ts",
    "verify:voice-agent": "tsx scripts/verify-multistep-voice.ts",
    "lint": "eslint src tests scripts",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "^12.10.0",
    "docx": "9.7.1",
    "exceljs": "^4.4.0",
    "file-box": "^1.4.15",
    "mammoth": "^1.11.0",
    "mime-types": "^3.0.1",
    "nanoid": "^5.1.6",
    "pdf-parse": "^2.4.5",
    "pino": "^10.1.0",
    "quickjs-emscripten": "0.32.0",
    "wechaty": "^1.20.2",
    "wechaty-puppet-wechat4u": "^1.14.14",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.13",
    "wechaty-puppet-mock": "^1.18.2"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.18.0",
      "brace-expansion@5": "5.0.8",
      "exceljs>archiver": "8.0.0",
      "exceljs>unzipper": "0.12.5",
      "form-data@2": "2.5.6",
      "form-data@4": "4.0.6",
      "fast-xml-parser": "5.8.0",
      "file-type": "link:vendor/file-type",
      "flash-store>rimraf": "link:vendor/rimraf",
      "nth-check": "2.1.1",
      "open-graph": "link:vendor/open-graph",
      "phin": "3.7.1",
      "qs": "6.15.2",
      "tough-cookie": "4.1.4",
      "protobufjs": "7.6.5",
      "tmp": "0.2.7",
      "uuid": "11.1.1",
      "xml2js": "0.6.2"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "esbuild",
      "leveldown",
      "protobufjs",
      "puppeteer"
    ]
  }
}
