{
  "name": "dangbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wechat group agent automation bot MVP.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "file-box": "^1.4.15",
    "mammoth": "^1.11.0",
    "mime-types": "^3.0.1",
    "nanoid": "^5.1.6",
    "pdf-parse": "^2.4.5",
    "pino": "^10.1.0",
    "wechaty": "^1.20.2",
    "wechaty-puppet-wechat4u": "^1.14.14",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "optionalDependencies": {
    "wechaty-puppet-wechat": "^1.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.13",
    "wechaty-puppet-mock": "^1.18.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "esbuild",
      "leveldown",
      "protobufjs",
      "puppeteer"
    ]
  }
}
