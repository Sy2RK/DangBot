bot:
  name: DangBot
  mentionAliases:
    - DangBot
    - 小当
wechat:
  puppet: ${WECHATY_PUPPET:-wechaty-puppet-wechat4u}
  puppetOptions: {}
agent:
  backend: ${DANGBOT_AGENT_BACKEND:-legacy}
  hermes:
    baseURL: ${DANGBOT_HERMES_BASE_URL:-http://127.0.0.1:18642}
    apiKey: ${DANGBOT_HERMES_API_KEY:-}
    sessionSecret: ${DANGBOT_HERMES_SESSION_SECRET:-}
    model: ${DANGBOT_HERMES_MODEL:-deepseek-v4-flash}
  mcp:
    enabled: true
    host: 127.0.0.1
    port: 18643
    apiKey: ${DANGBOT_MCP_API_KEY:-}
  sandbox:
    # Portable QuickJS-WASM only. Never falls back to the host shell.
    enabled: true
llm:
  baseURL: ${OPENAI_BASE_URL:-https://openrouter.ai/api/v1}
  apiKey: ${OPENAI_API_KEY:-}
  textModel: ${OPENAI_TEXT_MODEL:-qwen/qwen3.7-plus}
  visionModel: ${OPENAI_VISION_MODEL:-qwen/qwen3.7-plus}
  imageModel: ${OPENAI_IMAGE_MODEL:-bytedance-seed/seedream-4.5}
  videoModel: ${OPENAI_VIDEO_MODEL:-bytedance/seedance-2.0}
  tts:
    enabled: ${DOUBAO_TTS_ENABLED:-false}
    baseURL: ${DOUBAO_TTS_BASE_URL:-https://openspeech.bytedance.com/api/v3}
    apiKey: ${DOUBAO_TTS_API_KEY:-}
    resourceId: ${DOUBAO_TTS_RESOURCE_ID:-seed-tts-2.0}
    voice: ${DOUBAO_TTS_VOICE:-zh_male_tiancaitongsheng_uranus_bigtts}
    # -50 is 0.5x; 0 is normal; 100 is 2x.
    speechRate: 0
search:
  enabled: ${WEB_SEARCH_ENABLED:-false}
  provider: ${WEB_SEARCH_PROVIDER:-openrouter}
  braveApiKey: ${BRAVE_SEARCH_API_KEY:-}
  engine: ${OPENROUTER_WEB_SEARCH_ENGINE:-}
  searchContextSize: medium
  count: 5
  searchLang: zh-hans
  uiLang: zh-CN
  safeSearch: moderate
  extraSnippets: true
tools:
  policy:
    defaultHighRiskRequiresApproval: true
    allowNetworkTools: true
    allowFileWriteTools: false
    maxToolOutputChars: 8000
    denyTools: []
    roomToolOverrides: []
limits:
  voiceTasksPerMinute: 4
  videoTasksPerMinute: 2
  searchTasksPerMinute: 6
  maxAgentSteps: 8
  agentTaskTimeoutMs: 300000
  videoGenerationTimeoutMs: 600000
  videoGenerationPollIntervalMs: 10000
  maxVideoBytes: 52428800
  contextMessagesPerUser: 32
  publicContextMessagesPerRoom: 160
  memoryEntriesPerUser: 20
  globalMemoryEntries: 30
  userMemoryIdleMs: 3600000
  memoryConsolidationKeepContextMessages: 8
automations:
  enabled: true
  tickMs: 30000
  timezone: Asia/Shanghai
  maxConsecutiveFailures: 3
auth:
  systemAdmins: []
  allowTopicRoomBinding: false
  rooms:
    - stableId: optional-stable-room-id
      id: optional-wechat-runtime-room-id
      runtimeIds: []
      topic: 目标微信群名称
      enabled: true
      admins: []
