bot:
  name: DangBot
  mentionAliases:
    - DangBot
    - 小当
wechat:
  puppet: ${WECHATY_PUPPET:-wechaty-puppet-wechat4u}
  puppetOptions: {}
agent:
  hermes:
    baseURL: ${DANGBOT_HERMES_BASE_URL:-http://127.0.0.1:18642}
    apiKey: ${DANGBOT_HERMES_API_KEY:-}
    sessionSecret: ${DANGBOT_HERMES_SESSION_SECRET:-}
    model: ${DANGBOT_HERMES_MODEL:-deepseek-v4-flash}
  mcp:
    enabled: true
    host: 127.0.0.1
    port: 18643
    apiKey: ${DANGBOT_MCP_API_KEY:-}
    contextTtlMs: 600000
  memoryBridge:
    baseURL: ${DANGBOT_MEMORY_BRIDGE_URL:-http://127.0.0.1:18643}
    apiKey: ${DANGBOT_MEMORY_BRIDGE_API_KEY:-}
  sandbox:
    # Portable QuickJS-WASM only. Never falls back to the host shell.
    enabled: true
media:
  baseURL: ${DASHSCOPE_COMPATIBLE_BASE_URL:-https://dashscope.aliyuncs.com/compatible-mode/v1}
  nativeBaseURL: ${DASHSCOPE_NATIVE_BASE_URL:-https://dashscope.aliyuncs.com/api/v1}
  apiKey: ${DASHSCOPE_API_KEY:-}
  multimodalModel: ${DASHSCOPE_MULTIMODAL_MODEL:-qwen3.7-flash}
  imageModel: ${DASHSCOPE_IMAGE_MODEL:-qwen-image-3.0-pro}
  videoModels:
    textToVideo: ${DASHSCOPE_T2V_MODEL:-happyhorse-1.1-t2v}
    imageToVideo: ${DASHSCOPE_I2V_MODEL:-happyhorse-1.1-i2v}
    referenceToVideo: ${DASHSCOPE_R2V_MODEL:-happyhorse-1.1-r2v}
    videoEdit: ${DASHSCOPE_VIDEO_EDIT_MODEL:-happyhorse-1.0-video-edit}
  tts:
    enabled: ${DASHSCOPE_TTS_ENABLED:-true}
    apiKey: ${DASHSCOPE_TTS_API_KEY:-}
    model: ${DASHSCOPE_TTS_MODEL:-qwen-audio-3.0-tts-flash}
    voice: ${DASHSCOPE_TTS_VOICE:-longanhuan_v3.6}
limits:
  userRequestsPerMinute: 6
  roomRequestsPerMinute: 30
  imageTasksPerMinute: 6
  imageGenerationTasksPerMinute: 1
  voiceTasksPerMinute: 4
  videoTasksPerMinute: 2
  agentTaskTimeoutMs: 300000
  maxConcurrentTasks: 2
  maxConcurrentLongTasks: 1
  taskTimeoutMs: 120000
  videoGenerationTimeoutMs: 600000
  videoGenerationPollIntervalMs: 10000
  maxVideoBytes: 52428800
  maxReplyTextChars: 1800
  publicContextMessagesPerRoom: 160
  memoryEntriesPerUser: 20
  globalMemoryEntries: 30
  attachmentTtlHours: 24
  maxMcpOutputChars: 8000
reflection:
  enabled: true
  candidateThreshold: 5
  idleMs: 900000
  minSessionIntervalMs: 1800000
  maxTasksPerBatch: 8
  autoWriteConfidence: 0.95
automations:
  enabled: true
  tickMs: 30000
  timezone: Asia/Shanghai
  maxConsecutiveFailures: 3
auth:
  systemAdmins: []
  allowTopicRoomBinding: false
  rooms:
    - stableId: optional-stable-room-id
      id: optional-wechat-runtime-room-id
      runtimeIds: []
      topic: 目标微信群名称
      enabled: true
      admins: []
