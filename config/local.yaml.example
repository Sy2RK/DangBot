bot:
  name: DangBot
  mentionAliases:
    - DangBot
wechat:
  puppet: ${WECHATY_PUPPET:-wechaty-puppet-wechat4u}
  puppetOptions: {}
llm:
  baseURL: ${OPENAI_BASE_URL:-https://openrouter.ai/api/v1}
  apiKey: ${OPENAI_API_KEY:-}
  textModel: ${OPENAI_TEXT_MODEL:-qwen/qwen3.6-plus}
  visionModel: ${OPENAI_VISION_MODEL:-qwen/qwen3.6-plus}
  imageModel: ${OPENAI_IMAGE_MODEL:-}
limits:
  videoTasksPerMinute: 2
  maxVideoBytes: 52428800
  contextMessagesPerUser: 32
  publicContextMessagesPerRoom: 160
  memoryEntriesPerUser: 20
  globalMemoryEntries: 30
  userMemoryIdleMs: 3600000
  memoryConsolidationKeepContextMessages: 8
auth:
  systemAdmins: []
  rooms:
    - id: optional-wechat-room-id
      topic: 目标微信群名称
      enabled: true
      admins: []
